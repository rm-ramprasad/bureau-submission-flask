{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BureauFiles",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::opta-s3-demo/bureau-submissions/*"
    },
    {
      "Sid": "ReadReleases",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::opta-s3-demo/deploy/*"
    }
  ]
}
