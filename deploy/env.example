# Copy to /opt/submissions/.env on the server and fill in. chmod 600: it holds the database password.
# No quotes around values. No AWS keys: S3 access comes from the EC2 instance role.

SUBMISSIONS_DATABASE_URL=mysql+pymysql://<user>:<url-encoded-password>@<host>:3306/my_demo_db
SUBMISSIONS_SECRET_KEY=<generate on the server: python3 -c "import secrets; print(secrets.token_urlsafe(48))">

SUBMISSIONS_STORAGE=s3
SUBMISSIONS_S3_BUCKET=opta-s3-demo
SUBMISSIONS_S3_PREFIX=bureau-submissions
SUBMISSIONS_S3_REGION=ap-south-1

SUBMISSIONS_LOG_LEVEL=INFO
